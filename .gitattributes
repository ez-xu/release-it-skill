# Normalise line endings so the generated installers stay runnable everywhere.
* text=auto

*.py   text eol=lf
*.sh   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Promoted eval baselines are compared byte-for-byte.
evals/golden/**/expected.json -text
